# Server and trusted local reverse proxy
NODE_ENV=production
PORT=8080
TRUST_PROXY_HOPS=1
SHUTDOWN_TIMEOUT_MS=30000

# Required persistence
POSTGRES_URL=postgresql://user:password@postgres-host:5432/kiwi_ai?sslmode=require
POSTGRES_REQUIRED=true
POSTGRES_POOL_MAX=5
MONGODB_URI=mongodb+srv://user:password@mongo-host/kiwi_ai
MONGO_REQUIRED=true

# Browser origin and authentication
FRONTEND_ORIGIN=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id

# Product providers
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
AZURE_SPEECH_KEY=replace-with-azure-speech-key
AZURE_SPEECH_REGION=replace-with-azure-region

# Persistent recordings. Keep conversion disabled during shadow validation.
RECORDING_STORAGE_ROOT=/app/uploads/recordings-resumable
RECORDING_WORKER_ENABLED=false
RETENTION_WORKER_ENABLED=false
