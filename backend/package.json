{
  "name": "kiwi-ai-agent-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node index.js",
    "start": "node index.js",
    "test": "npm run test:all",
    "test:all": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness",
    "eval:jd": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runJdParseEval.js",
    "eval:cv": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runCvParseEval.js",
    "eval:match": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runCvJdMatchEval.js",
    "eval:interview": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runInterviewControllerEval.js",
    "eval:report": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runReportQaEval.js",
    "eval:all": "npm run eval:cv && npm run eval:jd && npm run eval:match && npm run eval:interview && npm run eval:report",
    "quality:all": "npm run test:all && npm run eval:all",
    "test:jd-safeguard": "NODE_ENV=test AI_TEST_MODE=mock ENABLE_AGENTIC_SAFEGUARDS=true vitest tests/robustness/jobDescription/jdParseAgenticSafeguard.test.js",
    "test:match-safeguard": "NODE_ENV=test AI_TEST_MODE=mock ENABLE_AGENTIC_SAFEGUARDS=true vitest tests/robustness/match/matchAgenticSafeguard.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.4.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.44.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
