{
  "name": "kiwi-ai-agent-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node index.js",
    "start": "node index.js",
    "test": "npm run test:all",
    "lint": "eslint .",
    "test:all": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/agent tests/robustness/contracts tests/robustness/cv tests/robustness/jd tests/robustness/llm tests/robustness/match tests/robustness/recording tests/robustness/report tests/robustness/retrieval tests/robustness/server tests/robustness/voice",
    "test:agent": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/agent",
    "test:contracts": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/contracts",
    "test:cv": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/cv",
    "test:jd": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/jd",
    "test:llm": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/llm",
    "test:match": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/match",
    "test:recording": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/recording",
    "test:report": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/report",
    "test:retrieval": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/retrieval",
    "test:server": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/server",
    "test:voice": "NODE_ENV=test AI_TEST_MODE=mock node tests/helpers/runVitestGroups.js tests/robustness/voice",
    "eval:jd": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runJdParseEval.js",
    "eval:cv": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runCvParseEval.js",
    "eval:match": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runCvJdMatchEval.js",
    "eval:interview": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runInterviewControllerEval.js",
    "eval:report": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runReportQaEval.js",
    "eval:baseline": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runBaselineComparisonEval.js",
    "eval:voice-robustness": "NODE_ENV=test AI_TEST_MODE=mock node eval/runners/runVoiceRobustnessEval.js",
    "eval:all": "npm run eval:cv && npm run eval:jd && npm run eval:seek && npm run eval:match && npm run eval:interview && npm run eval:report && npm run eval:e2e && npm run eval:green && npm run eval:baseline && npm run eval:voice-robustness",
    "quality:all": "npm run lint && npm run test:all && npm run eval:all",
    "test:jd-safeguard": "NODE_ENV=test AI_TEST_MODE=mock ENABLE_AGENTIC_SAFEGUARDS=true vitest tests/robustness/jd/jdParseAgenticSafeguard.test.js",
    "test:match-safeguard": "NODE_ENV=test AI_TEST_MODE=mock ENABLE_AGENTIC_SAFEGUARDS=true vitest tests/robustness/match/guardedMatchHumanReviewRobustness.test.js",
    "build": "node -e \"console.log('No backend build step required')\"",
    "start:local": "node index.js",
    "eval:cv-jd-match": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runCvJdMatchEval.js",
    "eval:seek": "NODE_ENV=test AI_TEST_MODE=real node eval/runners/runJdParseSeekBenchmark.js",
    "eval:e2e": "NODE_ENV=test AI_TEST_MODE=mock node eval/runners/runEndToEndInterviewEval.js",
    "eval:green": "NODE_ENV=test AI_TEST_MODE=mock node eval/runners/runGreenAgentEval.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "ffmpeg-static": "^5.2.0",
    "google-auth-library": "^10.4.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.44.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
