{
  "name": "kiwi-ai-agent-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node index.js",
    "start": "node index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:jd": "vitest run tests/jobDescription",
    "test:cv": "vitest run tests/cv",
    "test:match": "vitest run tests/match",
    "test:retrieval": "vitest run tests/retrieval",
    "test:ai-control": "vitest run tests/aiControl",
    "test:report": "vitest run tests/aiControl/reportQaAgent.test.js tests/aiControl/reflectionWriterService.test.js",
    "test:full-quality": "npm run test:jd && npm run test:cv && npm run test:match && npm run test:retrieval && npm run test:ai-control && npm run test:report",
    "eval:jd": "node eval/runners/runJdParseEval.js",
    "eval:cv": "node eval/runners/runCvParseEval.js",
    "eval:cv-jd-match": "node eval/runners/runCvJdMatchEval.js",
    "eval:interview": "node eval/runners/runInterviewControllerEval.js",
    "eval:report": "node eval/runners/runReportQaEval.js",
    "eval:full-quality": "npm run eval:jd && npm run eval:cv && npm run eval:cv-jd-match && npm run eval:interview && npm run eval:report",
    "quality:all": "npm run test:full-quality && npm run eval:full-quality"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.4.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
