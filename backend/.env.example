# Server
PORT=3000

# PostgreSQL
POSTGRES_URL=postgresql://user:password@localhost:5432/kiwi_ai

# MongoDB
MongoDB_URI=mongodb://localhost:27017/kiwi_ai

# Auth
JWT_SECRET=change_me_in_dev
GOOGLE_CLIENT_ID=your_google_client_id

# AI
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_TIMEOUT_MS=30000
MATCH_ENGINE=semantic
HF_TOKEN=your_huggingface_token
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_INFERENCE_PROVIDER=hf-inference
HF_EMBEDDING_TIMEOUT_MS=12000
SEMANTIC_TOP_K=3
SEMANTIC_MIN_SCORE=0.66
DISABLE_AI_JD_ENHANCEMENT=true
AGENTIC_SAFEGUARDS_ENABLED=false
COMPANY_VALUES_AI_ENABLED=false
COMPANY_MOTIVATION_AI_ENABLED=false
ENABLE_OPEN_SOURCE_NLP=false
PYTHON_NLP_TIMEOUT_MS=15000
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
AI_USAGE_COST_CURRENCY=NZD
AI_USAGE_USD_TO_COST_CURRENCY_RATE=1.65
COMMERCIAL_STRESS_HOURLY_RATE_NZD=35

# Azure Speech
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_ENDPOINT=https://eastasia.api.cognitive.microsoft.com/
AZURE_SPEECH_TTS_VOICE=en-NZ-MollyNeural
AZURE_SPEECH_STT_LANGUAGE=en-NZ

# ElevenLabs Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
ELEVENLABS_STT_AUDIO_FORMAT=pcm_16000
ELEVENLABS_STT_COMMIT_STRATEGY=vad
ELEVENLABS_STT_INCLUDE_TIMESTAMPS=false
ELEVENLABS_STT_FINAL_TIMEOUT_MS=5000
ELEVENLABS_STT_CLOSE_TIMEOUT_MS=1000
ELEVENLABS_STT_VAD_SILENCE_THRESHOLD_SECS=0.8
ELEVENLABS_STT_VAD_THRESHOLD=0.4
ELEVENLABS_STT_MIN_SPEECH_DURATION_MS=300
ELEVENLABS_STT_MIN_SILENCE_DURATION_MS=300
VOICE_STT_TURN_STOP_TIMEOUT_MS=2500

# Voice STT provider routing
# Level 1 session-start fallback only. Existing turns do not switch provider mid-recording.
VOICE_STT_PROVIDER=azure
VOICE_STT_FALLBACK_PROVIDER=elevenlabs
# Optional override. Example: azure,elevenlabs
VOICE_STT_PROVIDER_ORDER=

# Voice TTS provider routing
# TTS routing is independent from STT routing. Set this to elevenlabs for ElevenLabs voice without changing captions.
VOICE_TTS_PROVIDER=
VOICE_TTS_FALLBACK_PROVIDER=
VOICE_TTS_PROVIDER_ORDER=

COMPANY_SEARCH_PROVIDER=serper
SERPER_API_KEY=MyKey

COMPANY_SEARCH_MAX_QUERIES_PER_SESSION=2
COMPANY_SEARCH_RESULTS_PER_QUERY=5
COMPANY_VALUES_ENRICHMENT_TIMEOUT_MS=60000
COMPANY_VALUES_MIN_CONFIDENCE=0.65

COMPANY_VALUES_MAX_PAGES=6
COMPANY_VALUES_PAGE_TIMEOUT_MS=10000
