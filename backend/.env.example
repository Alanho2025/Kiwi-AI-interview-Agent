# Server
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_URL=postgresql://user:password@localhost:5432/kiwi_ai
POSTGRES_REQUIRED=false
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kiwi_ai
MONGO_REQUIRED=false
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Auth
JWT_SECRET=change_me_in_dev
GOOGLE_CLIENT_ID=your_google_client_id

# AI
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_INPUT_CACHE_HIT_PER_1M_USD=0.07
DEEPSEEK_INPUT_CACHE_MISS_PER_1M_USD=0.27
DEEPSEEK_OUTPUT_PER_1M_USD=1.10
JD_SAFEGUARD_AI_TIMEOUT_MS=6000
JD_AI_SKILL_ENHANCEMENT_TIMEOUT_MS=4000
AGENTIC_SAFEGUARD_MAX_REPARSE_ATTEMPTS=1
MATCH_ENGINE=semantic
HF_TOKEN=your_huggingface_token
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_EMBEDDING_ENDPOINT=
HF_INFERENCE_PROVIDER=hf-inference
HF_EMBEDDING_TIMEOUT_MS=12000
SEMANTIC_TOP_K=3
SEMANTIC_MIN_SCORE=0.66
DISABLE_AI_JD_ENHANCEMENT=true
AGENTIC_SAFEGUARDS_ENABLED=false
COMPANY_VALUES_AI_ENABLED=false
COMPANY_MOTIVATION_AI_ENABLED=false
ENABLE_OPEN_SOURCE_NLP=false
PYTHON_NLP_BIN=python3
PYTHON_NLP_TIMEOUT_MS=15000
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
AI_USAGE_COST_CURRENCY=NZD
AI_USAGE_USD_TO_COST_CURRENCY_RATE=1.65
AI_USAGE_PRICING_VERSION=2026-05-default
AI_USAGE_DEBUG=false
AZURE_SPEECH_STT_PER_AUDIO_HOUR_USD=1.00
AZURE_SPEECH_TTS_PER_1M_CHARS_USD=16.00
COMMERCIAL_STRESS_HOURLY_RATE_NZD=35
COMMERCIAL_STRESS_CONSERVATIVE_MINUTES=30
COMMERCIAL_STRESS_MODERATE_MINUTES=60
DISABLE_MATCH_ARTIFACT_CACHE=false
DISABLE_MODEL_ACTION_SELECTION=false
DISABLE_MODEL_ANSWER_UNDERSTANDING=false
ANSWER_UNDERSTANDING_ADAPTER_COMMAND=
ANSWER_UNDERSTANDING_TIMEOUT_MS=180

# Azure Speech
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=australiaeast
AZURE_SPEECH_ENDPOINT=https://eastasia.api.cognitive.microsoft.com/
AZURE_SPEECH_TTS_VOICE=en-NZ-MollyNeural
AZURE_SPEECH_STT_LANGUAGE=en-NZ
AZURE_SPEECH_TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
AZURE_STT_START_TIMEOUT_MS=5000

# ElevenLabs Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.25
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
ELEVENLABS_STT_AUDIO_FORMAT=pcm_16000
ELEVENLABS_STT_COMMIT_STRATEGY=vad
ELEVENLABS_STT_INCLUDE_TIMESTAMPS=false
ELEVENLABS_STT_FINAL_TIMEOUT_MS=5000
ELEVENLABS_STT_CLOSE_TIMEOUT_MS=1000
ELEVENLABS_STT_VAD_SILENCE_THRESHOLD_SECS=0.8
ELEVENLABS_STT_VAD_THRESHOLD=0.4
ELEVENLABS_STT_MIN_SPEECH_DURATION_MS=300
ELEVENLABS_STT_MIN_SILENCE_DURATION_MS=300
VOICE_STT_TURN_STOP_TIMEOUT_MS=2500
VOICE_BRIDGE_DELAY_MS=1200
VOICE_ACKNOWLEDGEMENT_TIMEOUT_MS=2200

# Voice Latency Optimization
VOICE_WARM_CONTEXT_ENABLED=true
VOICE_FAST_PATH_ENABLED=false
VOICE_AGENT_DECISION_FAST_PATH_ENABLED=true
VOICE_BACKGROUND_QUALITY_ENABLED=true
WARM_CONTEXT_TTL_MS=90000
RETENTION_WORKER_ENABLED=false
RETENTION_WORKER_INTERVAL_MS=21600000
RETENTION_BATCH_SIZE=100
WARM_CONTEXT_ROLLOUT_PERCENTAGE=100

# Voice STT provider routing
# Level 1 session-start fallback only. Existing turns do not switch provider mid-recording.
VOICE_STT_PROVIDER=azure
VOICE_STT_FALLBACK_PROVIDER=elevenlabs
# Optional override. Example: azure,elevenlabs
VOICE_STT_PROVIDER_ORDER=

# Voice TTS provider routing
# TTS routing is independent from STT routing. Set this to elevenlabs for ElevenLabs voice without changing captions.
VOICE_TTS_PROVIDER=
VOICE_TTS_FALLBACK_PROVIDER=
VOICE_TTS_PROVIDER_ORDER=

COMPANY_SEARCH_PROVIDER=serper
SERPER_API_KEY=your_serper_api_key

COMPANY_SEARCH_MAX_QUERIES_PER_SESSION=2
COMPANY_SEARCH_RESULTS_PER_QUERY=5
COMPANY_VALUES_ENRICHMENT_TIMEOUT_MS=60000
COMPANY_VALUES_MIN_CONFIDENCE=0.65
COMPANY_VALUES_MANUAL_MIN_CONFIDENCE=0.45

COMPANY_VALUES_MAX_PAGES=6
COMPANY_VALUES_PAGE_TIMEOUT_MS=10000
# Resumable voice recording storage and durable conversion worker.
RECORDING_WORKER_ENABLED=true
RECORDING_WORKER_INTERVAL_MS=2000
RECORDING_WORKER_LEASE_MS=120000
RECORDING_MAX_PROCESSING_ATTEMPTS=3
RECORDING_MAX_CHUNK_BYTES=2097152
RECORDING_MAX_SESSION_BYTES=104857600
RECORDING_MAX_CHUNKS=2000
# Set this to a persistent disk path in production. Defaults to backend/uploads/recordings-resumable.
RECORDING_STORAGE_ROOT=
# Optional ffmpeg binary override. ffmpeg-static is used when available.
FFMPEG_PATH=
